  "strings" : {
    "%@" : {
      "comment" : "A label displaying the number of questions in an exam. The argument is the number of questions in the exam.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@ %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@ of %@ correct" : {
      "comment" : "A description of the user's accuracy in a practice session. The first argument is the number of correct answers. The second argument is the number of total attempts.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ of %2$@ correct"
          }
        }
      }
    },
    "%@ questions" : {
      "comment" : "A label showing the number of questions in a task. The argument is the number of questions in the task.",
      "isCommentAutoGenerated" : true
    },
    "%@/%@" : {
      "comment" : "A label that shows the user's score and the total number of questions in the exam. The argument is the user's score, and the second argument is the total number of questions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@"
          }
        }
      }
    },
    "%@/%@ %@" : {
      "comment" : "A label showing the number of questions answered correctly and the total number of questions. The argument is the string “practice.correct”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@/%2$@ %3$@"
          }
        }
      }
    },
    "%@%%" : {
      "comment" : "A label showing the percentage of correct answers in a mock exam.",
